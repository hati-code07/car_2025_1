<!DOCTYPE html>
<html>
  <head>
    <title><%= siteTitle || 'Автомобили' %> - <%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' /> 
    <!-- Bootstrap CSS -->
<link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
  integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
  crossorigin="anonymous"/>
    
  </head>
  <body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
     <div class="container-fluid">
       <a class="navbar-brand" href="/"><%= siteTitle || 'Машины' %></a>
       <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
         <span class="navbar-toggler-icon"></span>
       </button>
       <div class="collapse navbar-collapse" id="navbarSupportedContent">
         <ul class="navbar-nav me-auto mb-2 mb-lg-0">
           <% if(Array.isArray(nav) && nav.length > 0) { 
               nav.forEach(function(item) { 
           %>
             <li class="nav-item">
               <a class="nav-link" href="<%= item.url || '#' %>">
                 <% if(item.icon) { %><%= item.icon %> <% } %>
                 <%= item.name || item.title %>
               </a>
             </li>
           <% 
               });
             } else { 
           %>
           <li class="nav-item">
             <a class="nav-link" href="/cars/porsche">PORSCHE CAYENNE</a>
           </li>
           <li class="nav-item">
             <a class="nav-link" href="/cars/golf">GOLF GTI 2025</a>
           </li>
           <li class="nav-item">
             <a class="nav-link" href="/cars/bmw">BMW M5 F90 competition</a>
           </li>
            <% } %>
         </ul>
          <ul class="nav navbar-nav navbar-right">
          <li class="nav-item">
         <a class="nav-link" href="/logreg">Войти</a>
         </li>
         </ul>
       </div>
     </div>
   </nav>

     <%- body %>
     <!-- Bootstrap Bundle with Popper -->
<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
  crossorigin="anonymous"
></script>
  </body>
</html>




<% layout('./layout/page.ejs') %>

<section class="page fade-in">

  <!-- HERO -->
  <header class="hero text-center py-5 mb-5">
    <div class="container">
      <p class="text-muted mb-2">Счетчик посещений: <%= counter %></p>

      <h1 class="display-4 mb-3">
        Добро пожаловать в <%= siteTitle || 'наш проект' %>
      </h1>

      <p class="lead mb-4">
        Учебный проект для управления автомобилями
      </p>

      <div class="dropdown d-inline-block">
        <button
          class="btn btn-primary btn-lg dropdown-toggle"
          type="button"
          id="carsDropdown"
          data-bs-toggle="dropdown"
          aria-expanded="false"
        >
          🚗 Выбрать автомобиль
        </button>

        <ul class="dropdown-menu">
          <li><a class="dropdown-item" href="/cars/porsche">Porsche Cayenne</a></li>
          <li><a class="dropdown-item" href="/cars/golf">Golf GTI 2025</a></li>
          <li><a class="dropdown-item" href="/cars/bmw">BMW M5 F90</a></li>
        </ul>
      </div>
    </div>
  </header>

  <!-- FEATURES -->
  <section class="container mb-5">
    <div class="row g-4">

      <% const features = [
        { icon: '⚡', title: 'Быстро', text: 'Мгновенный доступ ко всем функциям' },
        { icon: '🔒', title: 'Надежно', text: 'Данные защищены современными технологиями' },
        { icon: '👌', title: 'Удобно', text: 'Интуитивно понятный интерфейс' }
      ]; %>

      <% features.forEach(feature => { %>
        <div class="col-md-4">
          <article class="card h-100 text-center feature-card">
            <div class="card-body">
              <div class="feature-icon mb-3"><%= feature.icon %></div>
              <h3 class="h5"><%= feature.title %></h3>
              <p class="text-muted"><%= feature.text %></p>
            </div>
          </article>
        </div>
      <% }) %>

    </div>
  </section>

  <!-- AUTH -->
  <% if (!user) { %>
  <section class="container mb-5">
    <article class="card auth-card">
      <div class="card-header">
        <h2 class="h5 mb-0">🔑 Быстрый вход</h2>
      </div>

      <div class="card-body">
        <form action="/logreg" method="post" class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Имя пользователя</label>
            <input type="text" name="username" class="form-control" required>
          </div>

          <div class="col-md-6">
            <label class="form-label">Пароль</label>
            <input type="password" name="password" class="form-control" required>
          </div>

          <div class="col-12">
            <button class="btn btn-primary">Войти / Зарегистрироваться</button>
          </div>
        </form>
      </div>
    </article>
  </section>
  <% } %>

</section>


<% layout('./layout/page.ejs') %>
<p>Счетчик: <%= counter %></p> 

<div class="fade-in">
    <!-- Герой секция -->
    <section class="hero text-center py-5 mb-5">
        <div class="container">
            <h1 class="display-4 mb-4">Добро пожаловать в <%= siteTitle || 'наш проект' %></h1>
            <p class="lead mb-4">Лучшее решение для управления автомобилями</p>
            <div class="dropdown">
    <button class="btn btn-primary btn-lg dropdown-toggle" type="button" 
            id="carsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fas fa-car"></i> Выбрать автомобиль
    </button>
    
    <ul class="dropdown-menu" aria-labelledby="carsDropdown">
        <li><a class="dropdown-item" href="/cars/porsche">
            <i class="fas fa-sports-car"></i> Porsche Cayenne
        </a></li>
        <li><a class="dropdown-item" href="/cars/golf">
            <i class="fas fa-hatchback"></i> Golf GTI 2025
        </a></li>
        <li><a class="dropdown-item" href="/cars/bmw">
            <i class="fas fa-sedan"></i> BMW M5 F90
        </a></li>

    </ul>
</div>
        </div>
    </section>
    
    <!-- Карточки с фичами -->
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-bolt fa-3x text-primary mb-3"></i>
                    <h3>Быстро</h3>
                    <p>Мгновенный доступ ко всем функциям системы</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                    <h3>Надежно</h3>
                    <p>Ваши данные защищены современными технологиями</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-3x text-primary mb-3"></i>
                    <h3>Удобно</h3>
                    <p>Интуитивно понятный интерфейс для всех пользователей</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Форма входа (пример) -->
    <% if (!user) { %>
    <div class="card mt-5">
        <div class="card-header">
            <h3 class="mb-0"><i class="fas fa-sign-in-alt"></i> Быстрый вход</h3>
        </div>
        <div class="card-body">
            <form action="/logreg" method="post" class="row g-3">
                <div class="col-md-6">
                    <label for="username" class="form-label">Имя пользователя</label>
                    <input type="text" class="form-control" id="username" name="username" required>
                </div>
                <div class="col-md-6">
                    <label for="password" class="form-label">Пароль</label>
                    <input type="password" class="form-control" id="password" name="password" required>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-sign-in-alt"></i> Войти / Зарегистрироваться
                    </button>
                </div>
            </form>
        </div>
    </div>
    <% } %>
</div>